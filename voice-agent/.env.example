# Copier en .env et remplir. Ne jamais committer le .env réel (voir .gitignore).

# Token Vault avec accès en lecture seule à secret/tenants/poc/llm/{anthropic,gemini}.
# Pour ce POC local, le token de dev Vault convient ; ne pas réutiliser un token root
# au-delà de cette phase (voir RUNBOOK.md).
VAULT_TOKEN=

# anthropic | gemini — lequel des deux secrets Vault ci-dessus est utilisé.
LLM_PROVIDER=gemini

ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GEMINI_MODEL=gemini-2.5-flash
PIPER_VOICE=fr_FR-siwis-medium
